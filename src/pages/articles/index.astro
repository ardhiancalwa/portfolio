---
import Container from "@/components/ui/Container.astro";
import { articles } from "@/data/articles";
import BaseLayout from "@/layouts/BaseLayout.astro";

const orderedArticles = [...articles].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
);
---

<BaseLayout title="Articles" description="Recent writing and notes.">
  <section class="py-16 sm:py-20">
    <Container class="space-y-6">
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">Articles</h1>
      <p class="max-w-2xl text-sm text-zinc-600 dark:text-zinc-400">
        This page currently works as a safe placeholder index while full blog routing is prepared.
      </p>

      <ul class="space-y-4">
        {
          orderedArticles.map((article) => (
            <li id={article.slug} class="rounded-lg border border-zinc-200 p-5 dark:border-zinc-800">
              <p class="text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
                {article.category}
              </p>
              <h2 class="mt-2 text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">
                {article.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
                {article.description}
              </p>
              <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400">
                {new Date(article.publishedAt).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "2-digit",
                })}
              </p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>
