---
import Container from "@/components/ui/Container.astro";
import BlendHoverLink from "@/components/ui/BlendHoverLink.astro";
import ScrollRails from "@/components/layout/ScrollRails.astro";
import { projects } from "@/data/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";

const placeholderImage = "/images/projects/placeholder.svg";
---

<BaseLayout title="Projects" description="Selected projects and case studies." bodyClass="rails-scroll">
  <ScrollRails />
  <section class="py-16">
    <Container class="space-y-6">
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">Projects</h1>
      <ul class="space-y-4">
        {
          projects.map((project) => (
            <li class="project-card group rounded-lg border border-zinc-200 p-4 dark:border-zinc-800 sm:p-5">
              <article
                data-project-card
                data-project-url={project.caseStudyUrl ?? `/projects/${project.slug}`}
                tabindex="0"
                class="grid gap-4 md:grid-cols-[1fr_300px] md:items-start cursor-pointer"
              >
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">
                      {project.title}
                    </h2>
                    <span class="text-xs text-zinc-400 dark:text-zinc-500">|</span>
                    <span class="text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
                      {project.year}
                    </span>
                    <span class="text-xs text-zinc-400 dark:text-zinc-500">|</span>
                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-medium tracking-wide text-zinc-600 uppercase dark:text-zinc-300">
                      <img src={project.statusBadge.iconSrc} alt="" aria-hidden="true" class="h-3.5 w-3.5" />
                      <span>{project.statusBadge.label}</span>
                    </span>
                  </div>

                  <p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">{project.description}</p>

                  <ul class="mt-3 flex flex-wrap gap-2">
                    {project.techStack.map((tech) => (
                      <li class="rounded-full border border-zinc-300 px-2.5 py-1 text-[11px] tracking-wide text-zinc-600 uppercase dark:border-zinc-700 dark:text-zinc-300">
                        {tech}
                      </li>
                    ))}
                  </ul>

                  <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
                    {project.sourceCodeUrl ? (
                      <BlendHoverLink
                        href={project.sourceCodeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-zinc-700 dark:text-zinc-300"
                        label="Source Code"
                      />
                    ) : (
                      <span class="text-zinc-400 dark:text-zinc-500">Source N/A</span>
                    )}

                    {project.demoUrl ? (
                      <BlendHoverLink
                        href={project.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-zinc-700 dark:text-zinc-300"
                        label="Demo"
                      />
                    ) : (
                      <span class="text-zinc-400 dark:text-zinc-500">Demo N/A</span>
                    )}
                  </div>
                </div>

                <div class="project-image-wrap overflow-hidden rounded-md border border-zinc-200 opacity-100 transition-all duration-200 md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100 dark:border-zinc-800">
                  <img
                    src={project.image}
                    alt={project.imageAlt}
                    loading="lazy"
                    decoding="async"
                    onerror={`this.onerror=null;this.src='${placeholderImage}'`}
                    style={`object-position: ${project.imagePosition ?? "center"};`}
                    class="h-44 w-full object-cover md:h-52"
                  />
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll("[data-project-card]"));
    if (!cards.length) return;

    const openProject = (card) => {
      const url = card.getAttribute("data-project-url");
      if (!url) return;
      window.location.href = url;
    };

    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a,button")) return;
        openProject(card);
      });

      card.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        const target = event.target;
        if (target instanceof Element && target.closest("a,button")) return;
        event.preventDefault();
        openProject(card);
      });
    });
  })();
</script>

<style>
  .project-card {
    transition: border-color 180ms ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: rgba(15, 23, 42, 0.35);
  }

  .project-card [data-project-card]:focus-visible {
    outline: 2px solid rgba(15, 23, 42, 0.65);
    outline-offset: 4px;
  }

  :global(.dark) .project-card:hover,
  :global(.dark) .project-card:focus-within {
    border-color: rgba(244, 244, 245, 0.38);
  }

  :global(.dark) .project-card [data-project-card]:focus-visible {
    outline-color: rgba(244, 244, 245, 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-image-wrap {
      transition: none;
    }
  }
</style>
