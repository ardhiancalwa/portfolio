---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import ScrollRails from "@/components/layout/ScrollRails.astro";
import BlendHoverLink from "@/components/ui/BlendHoverLink.astro";
import Container from "@/components/ui/Container.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

export const getStaticPaths = async () => {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
};

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props as Props;
const { Content } = await entry.render();
const project = entry.data;
---

<ProjectLayout title={project.title} description={project.description} bodyClass="rails-scroll">
  <ScrollRails />
  <Container as="section" class="mx-auto max-w-4xl space-y-10">
    <header class="space-y-4">
      <p class="text-xs tracking-[0.16em] text-zinc-500 uppercase dark:text-zinc-400">Project Detail</p>
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">{project.title}</h1>
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
        {project.description}
      </p>
      <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400">
        <span>{project.role}</span>
        <span aria-hidden="true">|</span>
        <span>{project.year}</span>
        {
          project.statusLabel ? (
            <>
              <span aria-hidden="true">|</span>
              <span class="inline-flex items-center gap-2 font-semibold tracking-wide uppercase">
                {
                  project.statusIcon ? (
                    <img
                      src={project.statusIcon}
                      alt=""
                      class="h-5 w-5 object-contain"
                      loading="eager"
                      decoding="async"
                    />
                  ) : null
                }
                {project.statusLabel}
              </span>
            </>
          ) : null
        }
      </div>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        {
          project.repoUrl ? (
            <BlendHoverLink
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-zinc-700 dark:text-zinc-300"
              label="Source Code"
            />
          ) : (
            <span class="text-zinc-400 dark:text-zinc-500">Source N/A</span>
          )
        }
        {
          project.liveUrl ? (
            <BlendHoverLink
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-zinc-700 dark:text-zinc-300"
              label="Demo"
            />
          ) : (
            <span class="text-zinc-400 dark:text-zinc-500">Demo N/A</span>
          )
        }
      </div>
    </header>

    <article class="project-content border-t border-zinc-200 pt-6 dark:border-zinc-800">
      <Content />
    </article>
  </Container>
</ProjectLayout>

<style>
  .project-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgb(9 9 11);
  }

  .project-content :global(h3) {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.4;
    font-weight: 600;
    color: rgb(24 24 27);
  }

  .project-content :global(p),
  .project-content :global(li) {
    color: rgb(63 63 70);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .project-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0 0;
  }

  .project-content :global(img) {
    margin-top: 1rem;
    border: 1px solid rgb(228 228 231);
    border-radius: 0.25rem;
    width: 100%;
    height: auto;
  }

  :global(.dark) .project-content :global(h2),
  :global(.dark) .project-content :global(h3) {
    color: rgb(244 244 245);
  }

  :global(.dark) .project-content :global(p),
  :global(.dark) .project-content :global(li) {
    color: rgb(212 212 216);
  }

  :global(.dark) .project-content :global(img) {
    border-color: rgb(63 63 70);
  }

</style>
