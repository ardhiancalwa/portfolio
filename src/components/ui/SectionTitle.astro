---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { id, eyebrow, title, description, align = "left" } = Astro.props;
const textAlign = align === "center" ? "text-center" : "text-left";
const centerBlock = align === "center" ? "mx-auto" : "";
---

<header id={id} class={`space-y-3 ${textAlign}`}>
  {
    eyebrow && (
      <p class="text-xs font-medium tracking-[0.16em] text-zinc-500 uppercase dark:text-zinc-400">
        {eyebrow}
      </p>
    )
  }
  <h2
    class={`text-3xl leading-tight font-semibold tracking-tight text-balance text-zinc-950 dark:text-zinc-100 sm:text-4xl ${centerBlock}`}
  >
    {title}
  </h2>
  {
    description && (
      <p class={`max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg ${centerBlock}`}>
        {description}
      </p>
    )
  }
</header>
