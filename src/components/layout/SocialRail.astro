---
import type { RailSocialLink } from "@/types";

interface Props {
  socials: RailSocialLink[];
}

const { socials } = Astro.props;
---

<nav class="social-rail" data-social-rail aria-label="Social links">
  {
    socials.map((social) => (
      <a
        href={social.url}
        target={social.external ? "_blank" : undefined}
        rel={social.external ? "noopener noreferrer" : undefined}
        class="social-link"
        data-social-link
        aria-label={`Open ${social.ariaLabel}`}
      >
        <span class="social-dot" aria-hidden="true"></span>
        <span class="social-label">{social.label}</span>
      </a>
    ))
  }
</nav>

<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    if (reduceMotion || !finePointer) return;

    const rail = document.querySelector("[data-social-rail]");
    if (!rail) return;

    const socialLinks = Array.from(rail.querySelectorAll("[data-social-link]"));
    if (!socialLinks.length) return;

    let rafId = 0;
    let pointerX = 0;
    let pointerY = 0;
    let moving = false;

    const resetLinks = () => {
      socialLinks.forEach((link) => {
        link.style.setProperty("--social-x", "0px");
        link.style.setProperty("--social-y", "0px");
        link.style.setProperty("--social-scale", "1");
        link.style.setProperty("--social-strength", "0");
        link.classList.remove("is-nearest");
      });
      rail.classList.remove("is-moving");
    };

    const updateLinks = () => {
      rafId = 0;
      let nearest = null;
      let strongest = -1;

      socialLinks.forEach((link) => {
        const rect = link.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const dx = pointerX - centerX;
        const dy = pointerY - centerY;
        const distance = Math.hypot(dx, dy);
        const strength = Math.max(0, 1 - distance / 120);

        link.style.setProperty("--social-x", "0px");
        link.style.setProperty("--social-y", "0px");
        link.style.setProperty("--social-scale", "1");
        link.style.setProperty("--social-strength", strength.toFixed(3));

        if (strength > strongest) {
          strongest = strength;
          nearest = link;
        }
      });

      socialLinks.forEach((link) => link.classList.toggle("is-nearest", link === nearest));
      if (moving) {
        rail.classList.add("is-moving");
      }
    };

    rail.addEventListener("pointermove", (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      moving = true;
      if (!rafId) {
        rafId = window.requestAnimationFrame(updateLinks);
      }
    });

    rail.addEventListener("pointerleave", () => {
      moving = false;
      if (rafId) {
        window.cancelAnimationFrame(rafId);
        rafId = 0;
      }
      resetLinks();
    });

    socialLinks.forEach((link) => {
      link.addEventListener("focusin", () => {
        link.classList.add("is-nearest");
      });
      link.addEventListener("focusout", () => {
        if (!moving) {
          link.classList.remove("is-nearest");
        }
      });
    });
  })();
</script>
