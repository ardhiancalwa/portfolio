---
import Container from "@/components/ui/Container.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { profile } from "@/data/profile";
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="reveal-on-scroll min-h-full flex items-center py-10 sm:py-12 lg:py-14"
>
  <Container class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <SectionTitle
        id="about-heading"
        eyebrow="About"
        title={profile.about.headline}
      />
    </div>

    <div class="space-y-6 lg:col-span-7">
      {profile.about.paragraphs.map((paragraph) => (
        <p class="text-base leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-300">{paragraph}</p>
      ))}

      <ul class="flex flex-wrap gap-2.5 pt-1">
        {profile.about.highlights.map((item) => <li class="about-highlight-chip">{item}</li>)}
      </ul>
    </div>
  </Container>
</section>

<style>
  .about-highlight-chip {
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.78rem;
    line-height: 1.15;
    color: rgba(15, 23, 42, 0.82);
  }

  :global(.dark) .about-highlight-chip {
    border-color: rgba(226, 232, 240, 0.24);
    color: rgba(248, 250, 252, 0.86);
  }
</style>

