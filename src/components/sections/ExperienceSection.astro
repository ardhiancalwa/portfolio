---
import Container from "@/components/ui/Container.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { experiences } from "@/data/experience";

const featuredExperiences = experiences.slice(0, 3);
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  class="reveal-on-scroll min-h-full flex items-center border-b border-zinc-200 py-10 sm:py-12 lg:py-14 dark:border-zinc-800"
>
  <Container class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <SectionTitle
        id="experience-heading"
        title="EXPERIENCE"
        description="Software engineering experience shaped by real projects, mentoring, and technical collaboration."
      />
      <a
        href="/experience"
        class="project-text-link inline-flex items-center gap-2 whitespace-nowrap text-[1rem] font-normal tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-700 dark:focus-visible:outline-zinc-200"
      >
        <span>View All Experience</span>
        <span class="link-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredExperiences.map((experience) => (
          <article
            data-animate="experience-card"
            class="rounded-lg border border-zinc-200 p-5 dark:border-zinc-800"
          >
            <p class="text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
              {experience.type}
            </p>
            <h3 class="mt-3 text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">
              {experience.role}
            </h3>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">{experience.company}</p>
            <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">{experience.period}</p>
            <p class="experience-summary mt-3 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
              {experience.summary}
            </p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .project-text-link {
    color: rgba(15, 23, 42, 0.52);
    text-decoration: none;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .project-text-link:hover,
  .project-text-link:focus-visible {
    color: rgba(15, 23, 42, 0.92);
  }

  .project-text-link .link-arrow {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .project-text-link:hover .link-arrow,
  .project-text-link:focus-visible .link-arrow {
    transform: translateX(3px);
  }

  .experience-summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.dark) .project-text-link {
    color: rgba(226, 232, 240, 0.52);
  }

  :global(.dark) .project-text-link:hover,
  :global(.dark) .project-text-link:focus-visible {
    color: rgba(248, 250, 252, 0.94);
  }

</style>
